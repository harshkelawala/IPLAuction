{
  "name": "ipl-auction",
  "private": true,
  "version": "0.1.0",
  "description": "IPL auction game: up to 10 human franchises, AI bidders for the rest",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/rules && tsc -p packages/data",
    "seed": "npm run build-seed -w @ipl/data"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
